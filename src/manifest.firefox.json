{"version"                   : "26.9.26"
,"homepage_url"              : "https://github.com/eladkarako/webextension-tabs-sort-unique/"
,"author"                    : "Elad Karako"
,"manifest_version"          : 3
,"default_locale"            : "en_US"
,"name"                      : "__MSG_name_long__"
,"short_name"                : "__MSG_name_shrt__"
,"description"               : "__MSG_name_desc__"
,"permissions"               : ["tabs"]
,"background"                : {"scripts"        : "sw.js"
                               ,"type"           : "module"
                               }
,"browser_specific_settings" : {"gecko":{"id"                          : "tabs-sort-unique@webextension"
                                        ,"data_collection_permissions" : {"required": ["none"]}
                                        ,"strict_min_version"          : "140.0"
                                        }
                               }
,"icons"                     : {"16"  : "icons/16.png"
                               ,"32"  : "icons/32.png"
                               ,"48"  : "icons/48.png"
                               ,"128" : "icons/128.png"
                               }
,"action"                    : {"default_icon"  : {"16"  : "icons/16.png"
                                                  ,"32"  : "icons/32.png"
                                                  ,"48"  : "icons/48.png"
                                                  ,"128" : "icons/128.png"
                                                  }
                               }
}